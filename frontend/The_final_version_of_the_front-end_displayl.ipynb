    "# ==============================================================================\n",
    "# Cell 2: Isolated Telemetry Ingest Gateway (Self-Healing)\n",
    "# ==============================================================================\n",
    "import requests\n",
    "\n",
    "# Define direct mesh connection endpoint (Port conflict handled via kubectl)\n",
    "BASE_URL = \"http://localhost:9999/api\"\n",
    "\n",
    "def get_api_data(endpoint, scenario=\"scenario_b\"):\n",
    "    \"\"\"\n",
    "    Decouples serverless function tables to a Pandas DataFrame cleanly.\n",
    "    Note: Returns an empty DataFrame gracefully if the connection fails.\n",
    "    \"\"\"\n",
    "    url = f\"{BASE_URL}/{scenario}/{endpoint}\"\n",
    "    print(f\"📡 Querying decoupled indices: {scenario}/{endpoint}...\")\n",
    "\n",
    "    try:\n",
    "        response = requests.get(url, timeout=15)\n",
    "\n",
    "        if response.status_code == 200:\n",
    "            result = response.json()\n",
    "            if result.get(\"status\") == \"success\":\n",
    "                df = pd.DataFrame(result.get(\"data\", []))\n",
    "                print(f\"✅ Telemetry Frame Ingest Complete! ({len(df)} records)\")\n",
    "                return df\n",
    "            else:\n",
    "                print(f\"⚠️ API WARNING: Server returned negative status layout.\")\n",
    "        elif response.status_code == 404:\n",
    "            print(f\"❌ HTTP 404: Telemetry endpoint '{url}' not found in Nectar router tables.\")\n",
    "        else:\n",
    "            print(f\"❌ HTTP ERROR: Status Code {response.status_code}\")\n",
    "\n",
    "    except requests.exceptions.Timeout:\n",
    "        print(\"🚨 TIMEOUT: Fission function cluster failed to respond (Cold Start?).\")\n",
    "    except requests.exceptions.ConnectionError:\n",
    "        print(\"🚨 CONNECTION FAILURE: Check active kubectl port-forward on 9999 svc/router.\")\n",
    "    except Exception as e:\n",
    "        print(f\"🚨 EXCEPTION intercepted by tactical fallback core: {e}\")\n",
    "\n",
    "    return pd.DataFrame() # 保底返回空 DF，防止后续代码链式崩溃\n",
    "\n",
    "print(\"🚀 Cell 2: Fission Mesh Gateway operational! Interface pipeline ready!\")"
   ],
