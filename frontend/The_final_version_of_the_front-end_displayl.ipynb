    "# ==========================================\n",
    "# Cell 3: Executive Dark Tech Visualization Engine\n",
    "# 高级深色科技风：更克制、更像 dashboard / command center，避免廉价荧光塑料感\n",
    "# ==========================================\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "import math\n",
    "import os\n",
    "\n",
    "# -------------------------------------------------------------------\n",
    "# 🎛️ Ultra Premium Tech / Command-Center Theme\n",
    "# 目标：不是“荧光塑料感”，而是深色金融/能源监控大屏风格\n",
    "# -------------------------------------------------------------------\n",
    "def rgba(hex_color, alpha=1.0):\n",
    "    \"\"\"Convert #RRGGBB to rgba(r,g,b,a) for Plotly.\"\"\"\n",
    "    h = hex_color.strip().lstrip('#')\n",
    "    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)\n",
    "    return f\"rgba({r}, {g}, {b}, {alpha})\"\n",
    "\n",
    "THEME = {\n",
    "    # Cinematic command-centre base: almost black, with blue glass panels\n",
    "    \"bg\": \"#00030A\",\n",
    "    \"plot_bg\": \"#020711\",\n",
    "    \"panel\": \"rgba(3, 10, 22, 0.94)\",\n",
    "    \"panel_2\": \"rgba(10, 21, 40, 0.72)\",\n",
    "    \"grid_y\": \"rgba(126, 171, 217, 0.105)\",\n",
    "    \"grid_x\": \"rgba(126, 171, 217, 0.045)\",\n",
    "    \"axis_line\": \"rgba(147, 181, 215, 0.28)\",\n",
    "    \"text_main\": \"#F4F8FF\",\n",
    "    \"text_sub\": \"#9DAEC6\",\n",
    "    \"text_faint\": \"rgba(229, 237, 250, 0.62)\",\n",
    "\n",
    "    # Premium cold-tech accents: low saturation, no plastic neon blocks\n",
    "    \"cyan_line\": \"#00D5FF\",\n",
    "    \"electric\": \"#35A8FF\",\n",
    "    \"blue\": \"#2E78B7\",\n",
    "    \"violet\": \"#8B73D9\",\n",
    "    \"emerald\": \"#22C7A4\",\n",
    "    \"amber\": \"#C99A45\",\n",
    "    \"rose\": \"#C05B7A\",\n",
    "    \"steel\": \"#7C93B3\",\n",
    "    \"graphite\": \"#34445A\",\n",
    "    \"zero\": \"rgba(226, 232, 240, 0.34)\",\n",
    "\n",
    "    # Sentiment bars: cinematic muted teal / graphite / wine rose\n",
    "    \"bar_pos\": \"rgba(48, 180, 118, 0.78)\",\n",
    "    \"bar_neg\": \"rgba(190, 55, 86, 0.76)\",\n",
    "    \"bar_neu\": \"rgba(170, 168, 122, 0.64)\",\n",
    "\n",
    "    # Desaturated aerospace palette for categorical bars\n",
    "    \"colors\": ['#2F5F86', '#478D83', '#6C5F9D', '#A98242', '#985069', '#657892', '#716849', '#4D7482'],\n",
    "    \"bar_palette\": [\n",
    "        'rgba(44,123,182,0.78)', 'rgba(34,199,164,0.74)', 'rgba(139,115,217,0.72)',\n",
    "        'rgba(201,154,69,0.70)', 'rgba(192,91,122,0.70)', 'rgba(124,147,179,0.72)',\n",
    "        'rgba(163,143,76,0.68)', 'rgba(73,154,176,0.70)'\n",
    "    ],\n",
    "    \"glows\": [\n",
    "        'rgba(0, 213, 255, 0.135)',\n",
    "        'rgba(34, 199, 164, 0.115)',\n",
    "        'rgba(139, 115, 217, 0.110)',\n",
    "        'rgba(201, 154, 69, 0.098)',\n",
    "        'rgba(192, 91, 122, 0.104)',\n",
    "        'rgba(101, 120, 146, 0.070)',\n",
    "        'rgba(113, 104, 73, 0.060)',\n",
    "        'rgba(77, 116, 130, 0.065)'\n",
    "    ],\n",
    "    \"font\": \"Aptos Display, Inter, Segoe UI, Arial, sans-serif\",\n",
    "    \"mono\": \"JetBrains Mono, SFMono-Regular, Consolas, monospace\"\n",
    "}\n",
    "\n",
    "def add_hud_effects(fig):\n",
    "    \"\"\"Cinematic HUD frame for final report-quality dashboard images.\n",
    "    Adds layered glass panels, scanlines, micro-grid ticks, diagonal brackets and status chips.\n",
    "    All decorative elements live in paper coordinates, so data traces stay readable.\n",
    "    \"\"\"\n",
    "    # Outer glass panel and inner shadow\n",
    "    fig.add_shape(type=\"rect\", xref=\"paper\", yref=\"paper\", x0=-0.060, x1=1.060, y0=-0.115, y1=1.170,\n",
    "                  fillcolor=\"rgba(0, 3, 10, 0.78)\", line=dict(color=\"rgba(51, 184, 215, 0.18)\", width=1), layer=\"below\")\n",
    "    fig.add_shape(type=\"rect\", xref=\"paper\", yref=\"paper\", x0=-0.016, x1=1.016, y0=-0.020, y1=1.020,\n",
    "                  fillcolor=\"rgba(2, 7, 17, 0.16)\", line=dict(color=\"rgba(148, 190, 225, 0.095)\", width=1), layer=\"below\")\n",
    "\n",
    "    # Faint horizontal scan bands\n",
    "    for y, a, h in [(0.135, 0.030, 0.010), (0.365, 0.024, 0.008), (0.635, 0.022, 0.008), (0.875, 0.030, 0.010)]:\n",
    "        fig.add_shape(type=\"rect\", xref=\"paper\", yref=\"paper\", x0=0.0, x1=1.0, y0=y-h, y1=y+h,\n",
    "                      fillcolor=f\"rgba(51, 184, 215, {a})\", line_width=0, layer=\"below\")\n",
    "\n",
    "    # Micro-grid verticals and horizontals: subtle, not plastic\n",
    "    for x in np.linspace(0.08, 0.92, 8):\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x, x1=x, y0=-0.010, y1=1.010,\n",
    "                      line=dict(color=\"rgba(125, 211, 252, 0.030)\", width=1, dash=\"dot\"), layer=\"below\")\n",
    "    for y in np.linspace(0.12, 0.88, 5):\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=-0.005, x1=1.005, y0=y, y1=y,\n",
    "                      line=dict(color=\"rgba(125, 211, 252, 0.024)\", width=1, dash=\"dot\"), layer=\"below\")\n",
    "\n",
    "    # Top segmented telemetry rail\n",
    "    rail_segments = [(0.000, 0.145, THEME[\"cyan_line\"], 0.95, 3.0), (0.155, 0.305, THEME[\"electric\"], 0.40, 1.4),\n",
    "                     (0.318, 0.470, THEME[\"violet\"], 0.34, 1.4), (0.486, 0.650, THEME[\"emerald\"], 0.32, 1.4),\n",
    "                     (0.670, 0.760, THEME[\"amber\"], 0.28, 1.4)]\n",
    "    for x0, x1, c, a, w in rail_segments:\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x0, x1=x1, y0=1.122, y1=1.122,\n",
    "                      line=dict(color=rgba(c, a), width=w), layer=\"above\")\n",
    "\n",
    "    # Digital tick marks on top and bottom rails\n",
    "    for i, x in enumerate(np.linspace(0.035, 0.965, 24)):\n",
    "        height = 0.014 if i % 4 == 0 else 0.008\n",
    "        alpha = 0.34 if i % 4 == 0 else 0.16\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x, x1=x, y0=1.088, y1=1.088+height,\n",
    "                      line=dict(color=f\"rgba(51,184,215,{alpha})\", width=1), layer=\"above\")\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x, x1=x, y0=-0.061-height, y1=-0.061,\n",
    "                      line=dict(color=f\"rgba(51,184,215,{alpha*0.75})\", width=1), layer=\"above\")\n",
    "\n",
    "    # Status chips: richer but placed above data area\n",
    "    chips = [\n",
    "        (0.006, 0.070, \"LIVE\", \"rgba(51,184,215,0.18)\", \"rgba(51,184,215,0.42)\"),\n",
    "        (0.078, 0.190, \"FISSION API\", \"rgba(71,141,131,0.14)\", \"rgba(71,141,131,0.32)\"),\n",
    "        (0.198, 0.322, \"ELASTICSEARCH\", \"rgba(108,95,157,0.13)\", \"rgba(108,95,157,0.30)\"),\n",
    "        (0.330, 0.435, \"TEAM 68\", \"rgba(169,130,66,0.12)\", \"rgba(169,130,66,0.28)\")\n",
    "    ]\n",
    "    for x0, x1, label, fill, line in chips:\n",
    "        fig.add_shape(type=\"rect\", xref=\"paper\", yref=\"paper\", x0=x0, x1=x1, y0=1.138, y1=1.164,\n",
    "                      fillcolor=fill, line=dict(color=line, width=1), layer=\"above\")\n",
    "        fig.add_annotation(xref=\"paper\", yref=\"paper\", x=(x0+x1)/2, y=1.151, showarrow=False,\n",
    "                           text=label, font=dict(color=\"rgba(236,244,255,0.68)\", size=8, family=THEME[\"mono\"]))\n",
    "\n",
    "    # Side telemetry lane, opposite the legend area\n",
    "    for y0, y1, a in [(0.04, 0.18, 0.18), (0.22, 0.36, 0.11), (0.78, 0.93, 0.15)]:\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=-0.032, x1=-0.032, y0=y0, y1=y1,\n",
    "                      line=dict(color=f\"rgba(51,184,215,{a})\", width=3), layer=\"above\")\n",
    "    fig.add_annotation(xref=\"paper\", yref=\"paper\", x=-0.045, y=0.50, text=\"CLOUD<br>DATA<br>OPS\", showarrow=False,\n",
    "                       font=dict(color=\"rgba(236,244,255,0.25)\", size=8, family=THEME[\"mono\"]), textangle=-90)\n",
    "\n",
    "    # Corner brackets and diagonal slash details\n",
    "    bracket = \"rgba(51, 184, 215, 0.40)\"\n",
    "    soft = \"rgba(51, 184, 215, 0.20)\"\n",
    "    for x0, x1 in [(0.0, 0.085), (0.915, 1.0)]:\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x0, x1=x1, y0=1.0, y1=1.0, line=dict(color=bracket, width=1.35), layer=\"above\")\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x0, x1=x1, y0=0.0, y1=0.0, line=dict(color=soft, width=1.15), layer=\"above\")\n",
    "    for x in [0.0, 1.0]:\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x, x1=x, y0=0.915, y1=1.0, line=dict(color=bracket, width=1.35), layer=\"above\")\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x, x1=x, y0=0.0, y1=0.085, line=dict(color=soft, width=1.15), layer=\"above\")\n",
    "    for x0, y0, x1, y1 in [(0.010, 1.010, 0.040, 1.050), (0.960, 1.050, 0.990, 1.010), (0.010, -0.010, 0.040, -0.050), (0.960, -0.050, 0.990, -0.010)]:\n",
    "        fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=x0, x1=x1, y0=y0, y1=y1,\n",
    "                      line=dict(color=\"rgba(169,130,66,0.26)\", width=1.4), layer=\"above\")\n",
    "\n",
    "    # Bottom status rail and faint watermark\n",
    "    fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=0.0, x1=1.0, y0=-0.056, y1=-0.056,\n",
    "                  line=dict(color=\"rgba(125, 211, 252, 0.15)\", width=1), layer=\"above\")\n",
    "    fig.add_shape(type=\"line\", xref=\"paper\", yref=\"paper\", x0=0.72, x1=1.0, y0=-0.074, y1=-0.074,\n",
    "                  line=dict(color=\"rgba(169,130,66,0.22)\", width=2), layer=\"above\")\n",
    "    fig.add_annotation(xref=\"paper\", yref=\"paper\", x=0.995, y=-0.095, xanchor=\"right\", showarrow=False,\n",
    "                       text=\"COMP90024 · DISTRIBUTED INGEST / SENTIMENT ANALYTICS\", font=dict(color=\"rgba(228,237,248,0.40)\", size=9, family=THEME[\"mono\"]))\n",
    "    fig.add_annotation(xref=\"paper\", yref=\"paper\", x=0.012, y=-0.095, xanchor=\"left\", showarrow=False,\n",
    "                       text=\"RENDER QUALITY: FINAL REPORT\", font=dict(color=\"rgba(228,237,248,0.38)\", size=9, family=THEME[\"mono\"]))\n",
    "\n",
    "def apply_premium_layout(fig, title, x_title=\"\", y_title=\"\", show_legend=True, use_log_y=False, barmode=None):\n",
    "    \"\"\"Unified cinematic command-center layout.\n",
    "    The legend is now anchored from the RIGHT edge, not pushed beyond x=1.\n",
    "    This prevents the camera-exported PNG from cutting off legend text.\n",
    "    \"\"\"\n",
    "    fig.update_layout(\n",
    "        title=dict(text=title, font=dict(size=23, family=THEME[\"font\"], color=THEME[\"text_main\"]), x=0.018, y=0.966),\n",
    "        paper_bgcolor=THEME[\"bg\"],\n",
    "        plot_bgcolor=THEME[\"plot_bg\"],\n",
    "        font=dict(color=THEME[\"text_sub\"], family=THEME[\"font\"], size=12),\n",
    "        hovermode=\"x unified\",\n",
    "        # Wider canvas + safe right zone: keeps legend words visible in downloaded PNG.\n",
    "        width=1280,\n",
    "        margin=dict(t=170, b=120, l=88, r=245),\n",
    "        height=700,\n",
    "        hoverlabel=dict(bgcolor=\"rgba(1, 6, 18, 0.992)\", bordercolor=\"rgba(51, 184, 215, 0.62)\",\n",
    "                        font_size=13, font_family=THEME[\"mono\"], font_color=THEME[\"text_main\"]),\n",
    "        legend=(dict(\n",
    "            orientation=\"v\", yanchor=\"top\", y=0.965, xanchor=\"right\", x=0.992,\n",
    "            bgcolor=\"rgba(4, 11, 24, 0.80)\", bordercolor=\"rgba(125, 211, 252, 0.34)\", borderwidth=1,\n",
    "            font=dict(color=\"rgba(244,248,255,0.96)\", size=11, family=THEME[\"mono\"]),\n",
    "            tracegroupgap=8,\n",
    "            itemwidth=38,\n",
    "            itemsizing=\"constant\"\n",
    "        ) if show_legend else dict(visible=False)),\n",
    "        barmode=barmode,\n",
    "        transition=dict(duration=380, easing=\"cubic-in-out\"),\n",
    "        modebar=dict(bgcolor=\"rgba(0,0,0,0)\", color=\"rgba(229,237,250,0.38)\", activecolor=THEME[\"cyan_line\"])\n",
    "    )\n",
    "    fig.update_xaxes(title_text=x_title, title_font=dict(color=THEME[\"text_faint\"], size=12), showgrid=True, gridcolor=THEME[\"grid_x\"], zeroline=False,\n",
    "                     showline=True, linecolor=THEME[\"axis_line\"], tickfont=dict(color=THEME[\"text_sub\"], size=11), ticks=\"outside\", ticklen=5,\n",
    "                     tickcolor=\"rgba(125,211,252,0.24)\", showspikes=True, spikemode=\"across\", spikecolor=\"rgba(51, 184, 215, 0.36)\", spikethickness=1, spikedash=\"dot\")\n",
    "    common_y = dict(title_text=y_title, title_font=dict(color=THEME[\"text_faint\"], size=12), showgrid=True, gridcolor=THEME[\"grid_y\"], zeroline=False,\n",
    "                    showline=True, linecolor=THEME[\"axis_line\"], tickfont=dict(color=THEME[\"text_sub\"], size=11), ticks=\"outside\", ticklen=5,\n",
    "                    tickcolor=\"rgba(125,211,252,0.24)\", showspikes=True, spikecolor=\"rgba(51, 184, 215, 0.36)\", spikethickness=1, spikedash=\"dot\")\n",
    "    if use_log_y:\n",
    "        fig.update_yaxes(**common_y, type=\"log\", tickvals=[1, 10, 100, 1000, 10000, 100000], ticktext=['1', '10', '100', '1k', '10k', '100k'])\n",
    "    else:\n",
    "        fig.update_yaxes(**common_y)\n",
    "\n",
    "    # Premium trace finishing: low-saturation bars + subtle technical hatching.\n",
    "    fig.update_traces(selector=dict(type='bar'), marker_line_color=\"rgba(230, 238, 250, 0.14)\", marker_line_width=0.9,\n",
    "                      opacity=0.74, textfont=dict(color=THEME[\"text_main\"], family=THEME[\"mono\"]))\n",
    "    try:\n",
    "        fig.update_traces(selector=dict(type='bar'), marker_pattern_shape=\"/\", marker_pattern_solidity=0.045,\n",
    "                          marker_pattern_fgcolor=\"rgba(236,244,255,0.28)\")\n",
    "    except Exception:\n",
    "        pass\n",
    "    fig.update_traces(selector=dict(type='scatter'), marker=dict(line=dict(color=\"rgba(248, 250, 252, 0.26)\", width=1)))\n",
    "    fig.update_traces(selector=dict(type='pie'), textfont=dict(color=THEME[\"text_main\"], family=THEME[\"font\"], size=13))\n",
    "\n",
    "    add_hud_effects(fig)\n",
    "\n",
    "def filter_last_3_months(df, date_col='date'):\n",
    "    df = df.copy()\n",
    "    df['Date_dt'] = pd.to_datetime(df[date_col])\n",
    "    return df[df['Date_dt'] >= df['Date_dt'].max() - pd.DateOffset(months=3)].sort_values('Date_dt').copy()\n",
    "\n",
    "# ⚡ Ultra premium animation engine: duplicated glow trace + crisp data trace\n",
    "# Plotly does not render real CSS blur, so we simulate an expensive neon line using a wide translucent halo.\n",
    "def build_animation_frames(fig, df_pivot, dates, platforms, mode='lines', fill='none'):\n",
    "    \"\"\"Attach premium animated traces safely.\n",
    "    Important fix: Plotly converts fig.frames to a tuple internally, so we must build a normal\n",
    "    Python list first and assign it once. Do NOT call fig.frames.append(...).\n",
    "    \"\"\"\n",
    "    dates = list(dates)\n",
    "    platforms = list(platforms)\n",
    "    if len(dates) == 0 or len(platforms) == 0:\n",
    "        return\n",
    "\n",
    "    trace_meta = []\n",
    "    for i, plat in enumerate(platforms):\n",
    "        line_color = THEME[\"cyan_line\"] if 'oil' in str(plat).lower() else THEME[\"colors\"][i % len(THEME[\"colors\"])]\n",
    "        glow_color = THEME[\"glows\"][i % len(THEME[\"glows\"])]\n",
    "        fillcolor = glow_color if fill == 'tozeroy' else None\n",
    "        initial_y = [df_pivot.at[dates[0], plat]] + [None] * (len(dates) - 1)\n",
    "\n",
    "        # Halo layer: wide, transparent, no legend\n",
    "        fig.add_trace(go.Scatter(\n",
    "            x=dates, y=initial_y, name=f\"{plat} halo\", mode=\"lines\", line_shape='spline',\n",
    "            line=dict(color=rgba(line_color, 0.18), width=9),\n",
    "            hoverinfo=\"skip\", showlegend=False, connectgaps=True\n",
    "        ))\n",
    "        trace_meta.append((plat, \"halo\", line_color))\n",
    "\n",
    "        # Main layer: clean premium line\n",
    "        fig.add_trace(go.Scatter(\n",
    "            x=dates, y=initial_y, name=str(plat), mode=mode, line_shape='spline',\n",
    "            line=dict(color=line_color, width=3.0), fill=fill, fillcolor=fillcolor,\n",
    "            marker=dict(size=5.2, color=THEME[\"plot_bg\"], line=dict(color=line_color, width=1.7), opacity=0.92),\n",
    "            connectgaps=True\n",
    "        ))\n",
    "        trace_meta.append((plat, \"main\", line_color))\n",
    "\n",
    "    frames = []\n",
    "    for d in dates:\n",
    "        frame_data = []\n",
    "        for plat, kind, line_color in trace_meta:\n",
    "            y = [df_pivot.at[dt, plat] if dt <= d else None for dt in dates]\n",
    "            frame_data.append(go.Scatter(\n",
    "                y=y,\n",
    "                line=dict(color=rgba(line_color, 0.18) if kind == \"halo\" else line_color,\n",
    "                          width=9 if kind == \"halo\" else 3.0),\n",
    "                marker=dict(color=THEME[\"plot_bg\"], line=dict(color=line_color, width=1.7))\n",
    "            ))\n",
    "        frames.append(go.Frame(data=frame_data, name=str(d)))\n",
    "    fig.frames = frames\n",
    "\n",
    "    fig.update_layout(\n",
    "        updatemenus=[dict(\n",
    "            type=\"buttons\", showactive=False, x=0.0, y=1.165, xanchor=\"left\", yanchor=\"top\",\n",
    "            bgcolor=\"rgba(47, 199, 232, 0.12)\", bordercolor=\"rgba(47, 199, 232, 0.42)\", borderwidth=1,\n",
    "            font=dict(color=THEME[\"text_main\"], family=THEME[\"mono\"], size=12),\n",
    "            buttons=[dict(label=\"▶ PLAY DATA STREAM\", method=\"animate\",\n",
    "                          args=[None, dict(frame=dict(duration=50, redraw=False), transition=dict(duration=0), fromcurrent=True, mode=\"immediate\")])]\n",
    "        )],\n",
    "        sliders=[dict(\n",
    "            active=0, y=-0.035, x=0.03, len=0.94, bgcolor=\"rgba(15, 23, 42, 0.42)\",\n",
    "            bordercolor=\"rgba(47, 199, 232, 0.16)\",\n",
    "            currentvalue=dict(prefix=\"T-MARKER · \", font=dict(color=THEME[\"text_faint\"], size=10, family=THEME[\"mono\"])),\n",
    "            pad=dict(t=24, b=0),\n",
    "            steps=[dict(method=\"animate\", args=[[str(d)], dict(mode=\"immediate\", frame=dict(duration=0, redraw=False), transition=dict(duration=0))], label=\"\") for d in dates]\n",
    "        )]\n",
    "    )\n",
    "\n",
    "def premium_bar_sequence(n=None):\n",
    "    \"\"\"Muted premium colours for bars; avoids over-saturated neon.\"\"\"\n",
    "    pal = THEME.get(\"bar_palette\", THEME[\"colors\"])\n",
    "    return pal if n is None else [pal[i % len(pal)] for i in range(n)]\n",
    "\n",
    "# ==============================================================================\n",
    "# 📊 SCENARIO A\n",
    "# ==============================================================================\n",
    "def scenario_a_sentiment_trend(selected_topic=\"war\", filename=None):\n",
    "    df = get_api_data(\"sentiment\", scenario=\"scenario-a\")\n",
    "    if df.empty or 'date' not in df.columns: return\n",
    "    df = filter_last_3_months(df[df['topic'].str.lower() == selected_topic.lower()])\n",
    "    df['Date'] = df['Date_dt'].dt.date\n",
    "    df['Platform'] = df['platform'].str.capitalize()\n",
    "\n",
    "    dates = sorted(df['Date'].unique())\n",
    "    df_pivot = df.pivot_table(index='Date', columns='Platform', values='avg_sentiment', aggfunc='mean').reindex(dates).ffill().bfill()\n",
    "\n",
    "    fig = go.Figure()\n",
    "    build_animation_frames(fig, df_pivot, dates, df_pivot.columns, mode='lines') # ⚡ 动画激活\n",
    "    apply_premium_layout(fig, f\"📊 MATRIX A1: Dynamic Sentiment Stream [{selected_topic.upper()}]\", y_title=\"Valence Vector (-1 to 1)\")\n",
    "    fig.update_yaxes(range=[-1.05, 1.05], zeroline=True, zerolinecolor=\"rgba(226, 232, 240, 0.32)\")\n",
    "\n",
    "    if filename: fig.write_html(filename.replace(\".png\", \".html\"), include_plotlyjs=\"cdn\")\n",
    "    else: fig.show()\n",
    "\n",
    "def scenario_a_post_count(selected_topic=\"war\", filename=None):\n",
    "    df = get_api_data(\"sentiment\", scenario=\"scenario-a\")\n",
