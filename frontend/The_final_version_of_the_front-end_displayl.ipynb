    "def scenario_c_fuel_price_trend(filename=None):\n",
    "    \"\"\"Scenario C1: clean high-impact dual-axis chart matching the provided reference image.\n",
    "    This one is intentionally less HUD-heavy than other charts because the report screenshot needs\n",
    "    to look sharp, readable and premium: black canvas, strong cyan price stream, richer sentiment bars.\n",
    "    \"\"\"\n",
    "    df = get_api_data(\"fuel_sentiment_data\", scenario=\"scenario_c\")\n",
    "    if df.empty or 'date' not in df.columns:\n",
    "        return\n",
    "    if 'fuel_type' in df.columns:\n",
    "        df = df[df['fuel_type'].str.lower() == 'u91']\n",
    "    df = filter_last_3_months(df)\n",
    "    df['Date'] = df['Date_dt'].dt.date\n",
    "    sentiment = pd.to_numeric(df.get('avg_sentiment_score', 0), errors='coerce').fillna(0)\n",
    "    price = pd.to_numeric(df.get('avg_fuel_price', 0), errors='coerce').fillna(0)\n",
    "\n",
    "    fig = make_subplots(specs=[[{\"secondary_y\": True}]])\n",
    "\n",
    "    # Stronger but still premium sentiment colors: positive green, negative wine/orange, neutral warm khaki.\n",
    "    bar_colors = []\n",
    "    bar_lines = []\n",
    "    for val in sentiment:\n",
    "        if val > 0.05:\n",
    "            bar_colors.append(\"rgba(47, 190, 102, 0.86)\")       # richer data-screen green\n",
    "            bar_lines.append(\"rgba(113, 232, 151, 0.42)\")\n",
    "        elif val < -0.05:\n",
    "            # distinguish deep negative spikes without using cheap pure red\n",
    "            bar_colors.append(\"rgba(204, 82, 43, 0.88)\" if val > -0.35 else \"rgba(198, 23, 74, 0.92)\")\n",
    "            bar_lines.append(\"rgba(255, 152, 111, 0.48)\")\n",
    "        else:\n",
    "            bar_colors.append(\"rgba(194, 184, 118, 0.78)\")     # khaki neutral, like the reference\n",
    "            bar_lines.append(\"rgba(245, 235, 160, 0.34)\")\n",
    "\n",
    "    # Sentiment bars behind, on secondary axis.\n",
    "    fig.add_trace(go.Bar(\n",
    "        x=df['Date'], y=sentiment,\n",
    "        name=\"🤖 Social Sentiment Polarity\",\n",
    "        marker=dict(color=bar_colors, line=dict(color=bar_lines, width=0.45)),\n",
    "        opacity=0.92,\n",
    "        width=1000*3600*24*0.55,\n",
    "        hovertemplate=\"<b>%{x}</b><br>Sentiment: %{y:.3f}<extra></extra>\"\n",
    "    ), secondary_y=True)\n",
    "\n",
    "    # Cyan price stream: subtle glow layer + clear foreground with dots.\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=df['Date'], y=price, name=\"Fuel Price Glow\", mode='lines',\n",
    "        line=dict(color=\"rgba(0, 217, 255, 0.20)\", width=9, shape='spline'),\n",
    "        hoverinfo=\"skip\", showlegend=False\n",
    "    ), secondary_y=False)\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=df['Date'], y=price,\n",
    "        name=\"⛽ Avg Fuel Price (AUD)\",\n",
    "        mode='lines+markers',\n",
    "        line=dict(color=\"#00D8FF\", width=3.0, shape='spline'),\n",
    "        marker=dict(size=6.0, color=\"#00D8FF\", line=dict(color=\"rgba(0, 3, 10, 0.95)\", width=1.0)),\n",
    "        hovertemplate=\"<b>%{x}</b><br>Fuel Price: %{y:.3f} AUD/L<extra></extra>\"\n",
    "    ), secondary_y=False)\n",
    "\n",
    "    # Clean reference-style layout. No heavy HUD on this one.\n",
    "    fig.update_layout(\n",
    "        title=dict(\n",
    "            text=\"🚨 Scenario C: Australian Fuel Prices vs. Social Media Sentiment (Oil Topics)\",\n",
    "            x=0.028, y=0.955,\n",
    "            font=dict(size=26, color=\"#F7FAFF\", family=THEME[\"font\"])\n",
    "        ),\n",
    "        paper_bgcolor=\"#111111\",\n",
    "        plot_bgcolor=\"#111111\",\n",
    "        height=520,\n",
    "        width=1320,\n",
    "        # Extra canvas width + right-anchored legend: camera PNG will not crop the labels.\n",
    "        margin=dict(t=92, b=78, l=92, r=300),\n",
    "        font=dict(color=\"#F2F7FF\", family=THEME[\"font\"], size=15),\n",
    "        hovermode=\"x unified\",\n",
    "        barmode=\"overlay\",\n",
    "        legend=dict(\n",
    "            orientation=\"v\",\n",
    "            yanchor=\"top\", y=0.88,\n",
    "            xanchor=\"right\", x=0.992,\n",
    "            bgcolor=\"rgba(17,17,17,0.18)\",\n",
    "            borderwidth=0,\n",
    "            font=dict(color=\"#F7FAFF\", size=17, family=THEME[\"font\"]),\n",
    "            itemsizing=\"constant\",\n",
    "            itemwidth=42\n",
    "        ),\n",
    "        hoverlabel=dict(\n",
    "            bgcolor=\"rgba(7, 10, 16, 0.96)\",\n",
    "            bordercolor=\"rgba(0,216,255,0.70)\",\n",
    "            font=dict(color=\"#F7FAFF\", family=THEME[\"mono\"], size=13)\n",
    "        ),\n",
    "        modebar=dict(bgcolor=\"rgba(0,0,0,0)\", color=\"rgba(238,244,255,0.45)\", activecolor=\"#00D8FF\")\n",
    "    )\n",
    "\n",
    "    # Axes: reference-like strong cyan left axis, white right axis, clean horizontal grid.\n",
    "    fig.update_xaxes(\n",
    "        showgrid=False,\n",
    "        showline=False,\n",
    "        zeroline=False,\n",
    "        tickfont=dict(color=\"#F4F8FF\", size=16, family=THEME[\"font\"]),\n",
    "        ticks=\"\",\n",
    "        title_text=\"\"\n",
    "    )\n",
    "    fig.update_yaxes(\n",
    "        title_text=\"Fuel Price (AUD / Liter)\",\n",
    "        secondary_y=False,\n",
    "        title_font=dict(color=\"#00D8FF\", size=20, family=THEME[\"font\"]),\n",
    "        tickfont=dict(color=\"#00D8FF\", size=18, family=THEME[\"font\"]),\n",
    "        showgrid=True,\n",
    "        gridcolor=\"rgba(90, 125, 160, 0.42)\",\n",
    "        gridwidth=1.1,\n",
    "        zeroline=False,\n",
    "        showline=False,\n",
    "        rangemode=\"tozero\"\n",
    "    )\n",
    "    fig.update_yaxes(\n",
    "        title_text=\"Average Sentiment Score (Valence)\",\n",
    "        secondary_y=True,\n",
    "        title_font=dict(color=\"#F2F7FF\", size=20, family=THEME[\"font\"]),\n",
    "        tickfont=dict(color=\"#F2F7FF\", size=17, family=THEME[\"font\"]),\n",
    "        showgrid=False,\n",
    "        zeroline=True,\n",
    "        zerolinecolor=\"rgba(229, 237, 250, 0.55)\",\n",
    "        zerolinewidth=1.25,\n",
    "        showline=False,\n",
    "        range=[-0.72, 0.82]\n",
    "    )\n",
    "\n",
    "    # A thin zero reference line and subtle dark panel edge, like the sample.\n",
    "    fig.add_hline(y=0, yref=\"y2\", line=dict(color=\"rgba(240,246,255,0.52)\", width=1.15))\n",
    "\n",
    "    if filename:\n",
    "        fig.write_html(filename.replace(\".png\", \".html\"), include_plotlyjs=\"cdn\")\n",
    "    else:\n",
    "        fig.show()\n",
    "\n",
    "\n",
    "def scenario_c_oil_sentiment_trend(filename=None):\n",
    "    df = get_api_data(\"fuel_sentiment_data\", scenario=\"scenario_c\")\n",
    "    if df.empty or 'date' not in df.columns: return\n",
    "    df = filter_last_3_months(df)\n",
    "    df['Date'] = df['Date_dt'].dt.date\n",
    "    dates = sorted(df['Date'].unique())\n",
    "    df_plot = df.groupby('Date')['avg_sentiment_score'].mean().reindex(dates).ffill().fillna(0)\n",
    "    fig = go.Figure()\n",
    "    initial_y = [df_plot.loc[dates[0]]] + [None]*(len(dates)-1)\n",
    "    fig.add_trace(go.Scatter(x=dates, y=initial_y, name=\"Sentiment Halo\", mode='lines', line_shape='spline',\n",
    "                             line=dict(color=rgba(THEME[\"violet\"], 0.17), width=10), hoverinfo=\"skip\", showlegend=False))\n",
    "    fig.add_trace(go.Scatter(x=dates, y=initial_y, name=\"Media Sentiment Vector\", mode='lines+markers', line_shape='spline',\n",
    "                             line=dict(color=THEME[\"violet\"], width=3.4),\n",
    "                             marker=dict(size=5.5, color=THEME[\"plot_bg\"], line=dict(color=THEME[\"violet\"], width=1.8)),\n",
