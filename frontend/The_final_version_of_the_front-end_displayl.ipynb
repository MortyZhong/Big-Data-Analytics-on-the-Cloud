    "    df['Date'] = df['Date_dt'].dt.date\n",
    "    df['Count'] = pd.to_numeric(df.get('post_count', df.get('count', 1)), errors='coerce').fillna(1).clip(lower=1)\n",
    "    df['Platform'] = df['platform'].str.capitalize()\n",
    "\n",
    "    dates = sorted(df['Date'].unique())\n",
